#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define RSE 1

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            // -------------------------------------
            // |    ESC    |     1     |     2     |     3     |     4     |     5     |     6     | || |     7     |     8     |     9     |     0     |     -     |     =     |     `     |
            // |    TAB    |     Q     |     W     |     F     |     P     |     B     |     [     | || |     ]     |     J     |     L     |     U     |     Y     |     ;     |     \     |
            // | Left CTRL |     A     |     R     |     S     |     T     |     G     |     K     | || |     Z     |     M     |     N     |     E     |     I     |     O     |     '     |
            // |   L Shift |     Z     |     X     |     C     |     D     |     V     |             ||             |     K     |     H     |     ,     |     .     |     /     |  R Shift  |
            // | Caps Lock | Left Meta |     -     |     +     |                                     ||                                     |     ⭠     |     ⭣     |     ⭡     |     ⭢     |
            //                                                 |     K     |     M     |     K     | || |     Z     |     M     |     K     |                                                
            //                                                 |     K     |     M     |     K     | || |     Z     |     M     |     K     |                                                
            display-name = "Base";
            bindings = <
                &kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6       &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp GRAVE
                &kp TAB   &kp Q     &kp W     &kp F     &kp P     &kp B     &kp LBKT     &kp RBKT  &kp J     &kp L     &kp U     &kp Y     &kp SEMI  &kp BSLH
                &kp LCTRL &kp A     &kp R     &kp S     &kp T     &kp G     &mo RSE        &kp Y     &kp M     &kp N     &kp E     &kp I     &kp O     &kp SQT
                &kp LSHFT &kp Z     &kp X     &kp C     &kp D     &kp V                            &kp K     &kp H     &kp COMMA &kp DOT   &kp SLASH &kp RSHFT
                &kp CAPS  &kp LMETA &kp KP_MINUS &kp KP_PLUS                                                           &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT
                                                        &kp BSPC  &kp SPACE &kp ENTER    &kp ENTER &kp SPACE &kp DEL
                                                        &kp HOME  &kp LALT  &kp ESC      &kp RCTRL &kp RALT  &kp END
            >;
        };

        raise_layer { // Layer 1
            // -------------------------------------
            // |    ESC    |     F1    |     F2    |     F3    |     F4    |     F5    |     F6    | || |     F7    |     F8    |     F9    |    F10    |    F11    |    F12    |     `     |
            // |    TAB    |     Q     |     W     |     F     |     P     |     B     |     [     | || |     ]     |     J     |     L     |     U     |     Y     |     ;     |     \     |
            // | Left CTRL |     A     |     R     |     S     |     T     |     G     |     K     | || |     Z     |     M     |     N     |     E     |     I     |     O     |     '     |
            // |   L Shift |     Z     |     X     |     C     |     D     |     V     |             ||             |     K     |     H     |     ,     |     .     |     /     |  R Shift  |
            // | Caps Lock | Left Meta |     -     |     +     |                                     ||                                     |     ⭠     |     ⭣     |     ⭡     |     ⭢     |
            //                                                 |     K     |     M     |     K     | || |     Z     |     M     |     K     |                                                
            //                                                 |     K     |     M     |     K     | || |     Z     |     M     |     K     |                                                
            display-name = "Raise";
            bindings = <
                &kp ESC   &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6       &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &kp GRAVE
                &kp TAB   &kp Q     &kp W     &kp F     &kp P     &kp B     &kp LBKT     &kp RBKT  &kp J     &kp L     &kp U     &kp Y     &kp SEMI  &kp BSLH
                &kp LCTRL &kp A     &kp R     &kp S     &kp T     &kp G     &mo DEFAULT  &kp Y     &kp M     &kp N     &kp E     &kp I     &kp O     &kp SQT
                &kp LSHFT &kp Z     &kp X     &kp C     &kp D     &kp V                            &kp K     &kp H     &kp COMMA &kp DOT   &kp SLASH &kp RSHFT
                &kp CAPS  &kp LMETA &kp KP_MINUS &kp KP_PLUS                                                           &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT
                                                        &kp BSPC  &kp SPACE &kp ENTER    &kp ENTER &kp SPACE &kp DEL
                                                        &kp HOME  &kp LALT  &kp ESC      &kp RCTRL &kp RALT  &kp END
            >;
        };
        
        /* template_layer { // Layer N */
            /* // ------------------------------------- */
            /* // |    ESC    |     1     |     2     |     3     |     4     |     5     |     6     | || |     7     |     8     |     9     |     0     |     -     |     =     |     `     | */
            /* // |    TAB    |     Q     |     W     |     F     |     P     |     B     |     [     | || |     ]     |     J     |     L     |     U     |     Y     |     ;     |     \     | */
            /* // | Left CTRL |     A     |     R     |     S     |     T     |     G     |     K     | || |     Z     |     M     |     N     |     E     |     I     |     O     |     '     | */
            /* // |   L Shift |     Z     |     X     |     C     |     D     |     V     |             ||             |     K     |     H     |     ,     |     .     |     /     |  R Shift  | */
            /* // | Caps Lock | Left Meta |     -     |     +     |                                     ||                                     |     ⭠     |     ⭣     |     ⭡     |     ⭢     | */
            /* //                                                 |     K     |     M     |     K     | || |     Z     |     M     |     K     |                                                 */
            /* //                                                 |     K     |     M     |     K     | || |     Z     |     M     |     K     |                                                 */
            /* display-name = "Template"; */
            /* bindings = < */
            /*     &kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6       &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp GRAVE */
            /*     &kp TAB   &kp Q     &kp W     &kp F     &kp P     &kp B     &kp LBKT     &kp RBKT  &kp J     &kp L     &kp U     &kp Y     &kp SEMI  &kp BSLH */
            /*     &kp LCTRL &kp A     &kp R     &kp S     &kp T     &kp G     &mo 2        &kp Y     &kp M     &kp N     &kp E     &kp I     &kp O     &kp SQT */
            /*     &kp LSHFT &kp Z     &kp X     &kp C     &kp D     &kp V                            &kp K     &kp H     &kp COMMA &kp DOT   &kp SLASH &kp RSHFT */
            /*     &kp CAPS  &kp LMETA &kp KP_MINUS &kp KP_PLUS                                                           &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT */
            /*                                             &kp BSPC  &kp SPACE &kp ENTER    &kp ENTER &kp SPACE &kp DEL */
            /*                                             &kp HOME  &kp LALT  &kp ESC      &kp RCTRL &kp RALT  &kp END */
            /* >; */
        /* }; */
    };
 };

